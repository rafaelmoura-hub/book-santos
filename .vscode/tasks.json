{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "BOOK TESK: iniciar servidor",
            "type": "process",
            "command": "node",
            "args": ["scripts/dev-server.js"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "book-santos",
                "pattern": { "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "BOOK TESK: verificando servidor",
                    "endsPattern": "BOOK TESK: pronto em"
                }
            },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "runOptions": { "instanceLimit": 1 }
        }
    ]
}
