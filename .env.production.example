# Somente o domínio, sem https:// nem caminhos.
DOMAIN=teste.seu-dominio.com.br
ACME_EMAIL=seu-email@seu-dominio.com.br
# Use preferencialmente um projeto separado para homologação.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Opcional para habilitar criação de contas pelo administrador mestre.
# SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_NO_SERVIDOR
# Dados públicos exibidos em /legal/empresa. Não informe segredos nestes campos.
# BOOK_COMPANY_NAME=
# BOOK_COMPANY_CNPJ=
# BOOK_COMPANY_ADDRESS=
# BOOK_PRIVACY_EMAIL=
# Exigir TOTP para administradores: só após aplicar a migração 22 e testar o cadastro.
# BOOK_REQUIRE_ADMIN_MFA=true
# Habilite só após configurar o modelo de e-mail com código e testar SMTP.
# BOOK_RECOVERY_ENABLED=true
# Mantenha uma instância enquanto as sessões e limites não forem distribuídos.
# BOOK_INSTANCE_COUNT=1
# Somente no serviço de homologação, com projeto Supabase separado:
# BOOK_ENVIRONMENT=staging
# BOOK_PRODUCTION_SUPABASE_URL=https://PROJETO-DE-PRODUCAO.supabase.co
